######################################
#         COMMON IGNORE RULES        #
######################################

# Logs
*.log
*.out
*.err

# OS generated files
.DS_Store
Thumbs.db

# Environment and secret configs
.env
.env.* 

# Temporary files
*.swp
*.swo
*.tmp

######################################
#        BACKEND (SPRING BOOT)       #
######################################

# Build outputs
target/
out/
*.class
*.jar
*.war

# Maven / Gradle
.gradle/
.mvn/
**/.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/mvnw
!**/src/main/**/mvnw.cmd
!**/src/main/**/.mvn/wrapper/

######################################
#        FRONTEND (ANGULAR)          #
######################################

# Node dependencies
node_modules/
frontend/node_modules/

# Angular build outputs
dist/
build/
frontend/dist/
frontend/.angular/
frontend/.angular/cache/

# Optional lockfiles (can be regenerated)
package-lock.json
yarn.lock
pnpm-lock.yaml

######################################
#        DATABASE / RUNTIME          #
######################################

# Database runtime & container volumes
**/volume-data/
**/tempo-data/
data/
uploads/
**/uploads/

# Ignore DB dump files (exports), but keep project SQL scripts
*.dump
*.sock
mysql.sock

# Always keep SQL files written by developer
!*.sql

######################################
#        DOCKER CONFIG KEEP          #
######################################

# Ignore runtime, keep Docker setup
!Dockerfile
!docker-compose.yml
!*.yml

######################################
#            IDE / EDITORS           #
######################################

# IntelliJ
.idea/
*.iws
*.iml
*.ipr

# Eclipse
.classpath
.project
.settings/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# VS Code
.vscode/

######################################
#         KEYCLOAK THEMES FIX        #
######################################

# Track all Keycloak theme files
!**/themes/**/theme.properties
!**/themes/**/messages/*.properties
